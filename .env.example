# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://krishna:krishna@localhost:5432/krishna

# Embeddings: "bge-m3" (local). Hosted providers (openai/cohere/voyage) plug in via rag/embed.py.
EMBED_PROVIDER=bge-m3
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=mps
EMBED_BATCH_SIZE=8

# Query rewriting
ANTHROPIC_API_KEY=
REWRITE_MODEL=claude-haiku-5-5

# Optional reranker (off by default: ~2.2 GB extra RAM)
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3

DATA_DIR=data

# LLM for query rewrite + situation drafting: anthropic (REWRITE_MODEL) or nvidia (NVIDIA_MODEL)
LLM_PROVIDER=anthropic
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=

# OpenRouter (OpenAI-compatible); only ":free" models are allowed
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-26b-a4b-it:free

# Groq (OpenAI-compatible, free plan); models tried in order
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
GROQ_API_KEY=
